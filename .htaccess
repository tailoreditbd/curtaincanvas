RewriteEngine On
RewriteCond %{REQUEST_URI} ^(.*)/collection/(.*)$
RewriteRule ^collection/(.*)$ %1/curtain-collection/%2 [R=301,L]
RewriteRule ^project/our-completed-curtain-projects-in-bangladesh/?$ /curtaincanvas/project/ [R=301,L]
RewriteCond %{REQUEST_URI} ^(.*/)about/(?:reviews|curtain-canvas-reviews)/?$
RewriteRule ^about/(?:reviews|curtain-canvas-reviews)/?$ %1project/client-reviews/ [R=301,L]
