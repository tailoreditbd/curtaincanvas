RewriteEngine On
RewriteCond %{REQUEST_URI} ^(.*)/curtain-collection/custom-curtains(?:/index\.html)?/?$
RewriteRule ^curtain-collection/custom-curtains(?:/index\.html)?/?$ %1/collection/custom-curtains/ [R=301,L]
RewriteRule ^project/our-completed-curtain-projects-in-bangladesh/?$ /curtaincanvas/project/ [R=301,L]
RewriteRule ^about/curtain-canvas-reviews/?$ /curtaincanvas/about/reviews/ [R=301,L]
